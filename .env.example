APP_ENV=development

POSTGRES_USER=benchmark
POSTGRES_PASSWORD=benchmark
POSTGRES_DB=agent_benchmark
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

DATABASE_URL=postgresql+psycopg://benchmark:benchmark@postgres:5432/agent_benchmark
DATABASE_AUTO_CREATE_TABLES=true
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Public repositories work without this, but authenticated requests have higher limits.
GITHUB_TOKEN=

SANDBOX_IMAGE=python:3.12-slim
SANDBOX_WORKSPACE_ROOT=
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_COMMAND_TIMEOUT_SECONDS=120
SANDBOX_CLONE_TIMEOUT_SECONDS=120
SANDBOX_MAX_COMMAND_TIMEOUT_SECONDS=600
SANDBOX_NETWORK_ENABLED=false
SANDBOX_PULL_IMAGE=true
SANDBOX_MAX_LOG_BYTES=200000
PATCH_MAX_BYTES=1000000
PATCH_MAX_CHANGED_FILES=100

VITE_API_BASE_URL=http://localhost:8000

# Model provider keys are intentionally optional in the scaffold.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_MODEL_ENDPOINT=
