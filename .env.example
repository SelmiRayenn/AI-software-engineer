APP_ENV=development

POSTGRES_USER=benchmark
POSTGRES_PASSWORD=benchmark
POSTGRES_DB=agent_benchmark
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

DATABASE_URL=postgresql+psycopg://benchmark:benchmark@postgres:5432/agent_benchmark
DATABASE_AUTO_CREATE_TABLES=false
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Public repositories work without this, but authenticated requests have higher limits.
GITHUB_TOKEN=

SANDBOX_IMAGE=python:3.12-slim
SANDBOX_WORKSPACE_ROOT=
SANDBOX_RETAIN_WORKSPACES=false
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_COMMAND_TIMEOUT_SECONDS=120
SANDBOX_CLONE_TIMEOUT_SECONDS=120
SANDBOX_MAX_COMMAND_TIMEOUT_SECONDS=600
SANDBOX_NETWORK_ENABLED=false
SANDBOX_PULL_IMAGE=true
SANDBOX_MAX_OUTPUT_BYTES=200000
PATCH_MAX_BYTES=1000000
PATCH_MAX_CHANGED_FILES=100

VITE_API_BASE_URL=http://localhost:8000

# Real provider calls are opt-in. Keep this false for normal development and tests.
ENABLE_REAL_MODEL_CALLS=false
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
LOCAL_MODEL_ENDPOINT=

# Semantic retrieval is optional. Mock vectors require no network or credentials.
ENABLE_REAL_EMBEDDINGS=false
EMBEDDINGS_PROVIDER=mock
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=32
EMBEDDING_VECTOR_DIMENSIONS=
EMBEDDING_CHUNK_SIZE_CHARS=1000
EMBEDDING_CHUNK_OVERLAP_CHARS=100
EMBEDDING_AUTO_BUILD=false
